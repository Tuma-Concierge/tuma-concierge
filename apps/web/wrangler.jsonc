{
  "name": "tuma-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tumaffe.online",
      "custom_domain": true
    },
    {
      "pattern": "www.tumaffe.online/*",
      "zone_name": "tumaffe.online"
    }
  ]
}
