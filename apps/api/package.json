{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "dev:worker": "wrangler dev",
    "deploy": "node ../../scripts/preflight-deploy.mjs && wrangler deploy",
    "test": "tsx --test src/lib/rollback-compat.test.ts src/lib/rollback.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@libsql/client": "^0.14.0",
    "@tuma/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.5",
    "jose": "^5.9.6",
    "webpush-webcrypto": "^1.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.1"
  }
}
