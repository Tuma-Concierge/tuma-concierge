# Copy to .env.local. Never commit real values.

# Auth
JWT_SECRET=

# Key for the HMAC that protects stored verification codes. A 6-digit code
# has only 900k possibilities, so a plain hash of one is trivially reversed
# by anyone who can read the database — this key is what makes those stored
# hashes useless on their own. Optional: falls back to JWT_SECRET (under a
# separate label) when unset.
OTP_PEPPER=

# Database (omit both to use a local ./local.db file automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Master key that encrypts payment aggregator API credentials an admin
# enters through Settings → Payments (see apps/api/src/lib/crypto.ts and
# apps/api/src/payments/credentials.ts). Any string works — it's hashed
# down to a fixed-size key — but treat it like any other production secret:
# generate a long random value and never change it without re-entering the
# credentials it was protecting (they become undecryptable otherwise).
CREDENTIALS_ENCRYPTION_KEY=

# CORS (comma-separated). Defaults to localhost:3000/3001 + staging Render URLs.
CORS_ORIGINS=

# Mobile money — Yo! Payments aggregates a single integration across MTN
# MoMo and Airtel Money in Uganda. Which aggregators are active/primary is
# admin-configurable (Settings → Payments), and all credentials below can
# now be entered there instead — the vars here are only a fallback for
# whichever fields an admin hasn't (yet) saved through the UI. With nothing
# set either way, escrow funding/payout run against the built-in mock
# simulator, so the app works end-to-end with zero configuration.
YO_BASE_URL=
YO_TARGET_ENV=sandbox
YO_API_USERNAME=
YO_API_PASSWORD=
YO_CALLBACK_URL=
# Shared secret proving a payment callback really came from Yo!. Put it in
# the callback URL you register with them (…/v1/payments/yo/callback?token=…)
# or have them send it as an X-Tuma-Callback-Token header. Callbacks are
# refused outright while this is unset, so nobody can drive payment state by
# POSTing to a public endpoint.
YO_CALLBACK_SECRET=

# Flutterwave (hosted checkout — cards + mobile money). Same admin-UI vs.
# env-var fallback relationship as Yo! above.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Legacy direct MTN MoMo Open API client (apps/api/src/momo/client.ts) —
# unused while PAYMENTS_PROVIDER is not "yo"; kept as a reference for a
# possible future direct-MTN integration path.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=UGX
MOMO_CALLBACK_URL=
